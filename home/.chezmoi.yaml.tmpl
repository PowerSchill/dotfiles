{{- /* Detect special environments first */ -}}
{{- $codespaces:= env "CODESPACES" | not | not -}}
{{- $ci:= env "CI" | not | not -}}

{{- /* Checks if running interactively */ -}}
{{- /* In Codespaces and CI, force non-interactive mode */ -}}
{{- $interactive := and stdinIsATTY (not $codespaces) (not $ci) -}}

{{/* ###########################################################################
Roles

A machine's configuration is the union of the `base` set plus one bucket per
enabled role. Roles are chosen once at `chezmoi init` and persisted, so they no
longer depend on network-visible hostname/FQDN state.

To change a role later use the `cmrole` shell function (see
dot_config/zsh/functions/role.zsh), which drives:

    chezmoi init --promptBool "<role>=true|false" && chezmoi apply

The prompt text below is deliberately the bare role name: chezmoi keys
--promptBool on the *prompt string*, not on the state key.
########################################################################### */}}
{{- $roleNames := list "dev" "gui" "work" "personal" "security" "onepassword" "homelab" -}}
{{- $roleDefaults := dict
      "dev" true
      "gui" true
      "work" false
      "personal" false
      "security" false
      "onepassword" false
      "homelab" false -}}
{{- "" -}}

{{/* ephemeral is machine *lifetime*, not a capability: it is force-set by the
     environment detection below rather than chosen, so it stays a plain flag. */}}
{{- $ephemeral := false -}}
{{- "" -}}

{{/* ###########################################################################
Operating System Identification
########################################################################### */}}
{{- $osID := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* Override some arch designations */}}
{{- $uname_arch := "" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if eq (output "uname" "-m" | trim) "aarch64" -}}
{{-     $uname_arch = "arm64" -}}
{{-   else -}}
{{-     $uname_arch = output "uname" "-m" | trim -}}
{{-   end -}}
{{- end -}}

{{/* detect CI runners, GitHub codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if or (env "CI") (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{- end -}}

{{- $hostname := .chezmoi.hostname -}}

{{/* On macOS the hostname can change depending on the network, this gives a more stable result */}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "ComputerName" | trim -}}
{{- end -}}

{{/* ###########################################################################
Role selection
########################################################################### */}}
{{- $role := dict -}}
{{- if $ephemeral -}}
{{/*   Throwaway machines get a usable shell and toolchain, nothing else. */}}
{{-   range $r := $roleNames -}}
{{-     $_ := set $role $r (eq $r "dev") -}}
{{-   end -}}
{{- else if stdinIsATTY -}}
{{-   range $r := $roleNames -}}
{{-     $_ := set $role $r (promptBoolOnce $ (printf "role_%s" $r) $r (index $roleDefaults $r)) -}}
{{-   end -}}
{{- else -}}
{{/*   Non-interactive and not detected as ephemeral: fall back to defaults. */}}
{{-   range $r := $roleNames -}}
{{-     $_ := set $role $r (index $roleDefaults $r) -}}
{{-   end -}}
{{- end -}}

{{/* Ordered list of enabled roles, used to index into .packages buckets. */}}
{{- $roles := list -}}
{{- range $r := $roleNames -}}
{{-   if index $role $r -}}
{{-     $roles = append $roles $r -}}
{{-   end -}}
{{- end -}}

{{/* ###########################################################################
Sets the appearance of the desktop environment.
########################################################################### */}}
{{- $appearance := "dark" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $appearance = output "sh" "-c" "defaults read -g AppleInterfaceStyle 2>/dev/null || echo Light" | trim | lower -}}
{{-   if ne $appearance "dark" -}}
{{-     $appearance = "light" -}}
{{-   end -}}
{{- end }}


{{- $name := "Mark E. Schill" -}}
{{- $email := "" -}}
{{- if index $role "personal" -}}
{{-   $email = "Mark.Schill@cmschill.net" -}}
{{- end -}}

{{- if not $ephemeral -}}
{{-   if $email | empty -}}
{{-     if stdinIsATTY -}}
{{-       $email = promptStringOnce . "email" "What is your email address?" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}


{{- if $interactive -}}
{{-   writeToStdout "💡 Tip: you can re-enter your details with `chezmoi init --data=false`.\n" -}}
{{- end -}}
{{- $remoteContainers:= env "REMOTE_CONTAINERS" | not | not -}}
{{- $devcontainer:= or $remoteContainers (stat "/.dockerenv") | not | not -}}
{{- $wsl:= and (lookPath "wslinfo") (output "wslinfo" "--version" | trim | ne "") | not | not -}}



{{/* ###########################################################################
Work machine and Windows enterprise enrollment

`isWork` follows the `work` Role, so Roles stay the single source of truth.

`dsregcmd /status` reports whether this device is Entra ID (Azure AD) joined,
Entra registered (WorkplaceJoined), AD domain joined, and MDM (Intune)
enrolled. It runs on native Windows, and in WSL through Windows interop. On
any other OS, or when it cannot run, every flag is false and the tenant
fields are empty.
########################################################################### */}}
{{- $isWork := index $role "work" -}}

{{- $dsreg := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   if lookPath "dsregcmd.exe" -}}
{{-     $dsreg = output "dsregcmd.exe" "/status" -}}
{{-   end -}}
{{- else if $wsl -}}
{{-   if lookPath "dsregcmd.exe" -}}
{{-     $dsreg = output "sh" "-c" "dsregcmd.exe /status 2>/dev/null || true" -}}
{{-   else if stat "/mnt/c/Windows/System32/dsregcmd.exe" -}}
{{-     $dsreg = output "sh" "-c" "/mnt/c/Windows/System32/dsregcmd.exe /status 2>/dev/null || true" -}}
{{-   end -}}
{{- end -}}
{{- $isEntraIDJoined := regexMatch "(?m)^\\s*AzureAdJoined\\s*:\\s*YES" $dsreg -}}
{{- $isEntraRegistered := regexMatch "(?m)^\\s*WorkplaceJoined\\s*:\\s*YES" $dsreg -}}
{{- $isADDomainJoined := regexMatch "(?m)^\\s*DomainJoined\\s*:\\s*YES" $dsreg -}}
{{- $isIntuneJoined := regexMatch "(?m)^\\s*MdmUrl\\s*:\\s*\\S" $dsreg -}}
{{- $entraIDTenantName := regexReplaceAll "^\\s*TenantName\\s*:\\s*" (regexFind "(?m)^\\s*TenantName\\s*:.*$" $dsreg) "" | trim -}}
{{- $entraIDTenantId := regexReplaceAll "^\\s*TenantId\\s*:\\s*" (regexFind "(?m)^\\s*TenantId\\s*:.*$" $dsreg) "" | trim -}}

{{- /* GitHub account used by scripts (CHEZMOI_GITHUB_USERNAME). Override it  */ -}}
{{- /* per machine with `githubUsername` in your local chezmoi config.        */ -}}
{{- $githubUsername := "PowerSchill" -}}
{{- if get . "githubUsername" -}}
{{-   $githubUsername = .githubUsername -}}
{{- end -}}

{{- /* 1Password Environment ID for the copilot-ssh helper. Optional and not  */ -}}
{{- /* prompted: set `opCopilotEnvironmentId` in your local chezmoi config.   */ -}}
{{- $opCopilotEnvironmentId := get . "opCopilotEnvironmentId" | default "" -}}





{{- /* CLIs wrapped by a 1Password shell plugin (`op plugin run -- <cli>`).     */ -}}
{{- /* Accepts a comma-separated string or a YAML list in your local chezmoi    */ -}}
{{- /* config; not prompted, since the default suits every machine. Each entry  */ -}}
{{- /* still needs a one-off `op plugin init <cli>`. Shell plugins are not      */ -}}
{{- /* supported in WSL, where the wrappers are skipped entirely.               */ -}}
{{- /* See docs/1password-shell-plugins.md.                                     */ -}}
{{- $opShellPlugins := list "gh" -}}
{{- if hasKey . "opShellPlugins" -}}
{{-   $opShellPlugins = .opShellPlugins -}}
{{- end -}}
{{- if kindIs "string" $opShellPlugins -}}
{{-   $opShellPlugins = splitList "," $opShellPlugins -}}
{{- end -}}
{{- /* Trim before de-duplicating: "aws, aws " would otherwise survive uniq as */ -}}
{{- /* two distinct strings and only collapse to duplicates afterwards.        */ -}}
{{- $opShellPluginList := list -}}
{{- range $opShellPlugins -}}
{{-   $entry := . | toString | trim -}}
{{-   if $entry -}}{{- $opShellPluginList = append $opShellPluginList $entry -}}{{- end -}}
{{- end -}}
{{- $opShellPluginList = $opShellPluginList | sortAlpha | uniq -}}

{{- /* SSH public key used to sign Git commits when the 1Password SSH agent is  */ -}}
{{- /* driving signing. Copy it from the 1Password app ("Configure Commit       */ -}}
{{- /* Signing" -> Copy Snippet). Works on WSL, native Windows and macOS; the   */ -}}
{{- /* platform-specific signer binary is auto-detected. Ignored when           */ -}}
{{- /* useYubiKey is true. See docs/git-signing.md.                             */ -}}
{{- /*                                                                          */ -}}
{{- /* These are PUBLIC keys, not secrets — the personal one is already         */ -}}
{{- /* published at https://github.com/DevSecNinja.keys — so they are safe to   */ -}}
{{- /* ship as defaults. Two defaults ship: one for work machines (see          */ -}}
{{- /* `isWork` below) and one for everything else; the pick happens after the  */ -}}
{{- /* Entra ID detection has run. Override it per-machine by setting           */ -}}
{{- /* `gitSigningKey` in your local chezmoi config. `get` (not `hasKey`) so an */ -}}
{{- /* existing config that already carries an empty value still picks a        */ -}}
{{- /* default up.                                                              */ -}}
{{- $gitSigningKeyPersonal := "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMzFDH1jE1t0tW1Bg89b0YZmBgSUC27AgBRxyIW+dk/H" -}}
{{- $gitSigningKeyWork := "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPdccqdHq+xUo8RMqFLn7LfjHMOF+TZOqVnBTsK7VNyU" -}}
{{- $gitSigningKey := "" -}}
{{- if get . "gitSigningKey" -}}
{{-   $gitSigningKey = .gitSigningKey -}}
{{- end -}}

{{- /* Path to the 1Password SSH signer binary. Empty means auto-detect per   */ -}}
{{- /* platform: op-ssh-sign-wsl.exe in WSL, op-ssh-sign.exe on Windows and   */ -}}
{{- /* op-ssh-sign on macOS. Set this for a non-standard install, or on Linux */ -}}
{{- /* where there is no standard path. See docs/git-signing.md.             */ -}}
{{- $opSshSignProgram := "" -}}
{{- if hasKey . "opSshSignProgram" -}}
{{-   $opSshSignProgram = .opSshSignProgram -}}
{{- end -}}

{{- /* 1Password vault the SSH agent offers keys from, written to the Windows  */ -}}
{{- /* agent.toml. Empty means pick per machine below: the work vault on work */ -}}
{{- /* devices, Private elsewhere. Set it to use a differently-named vault.   */ -}}
{{- /* See docs/git-signing.md.                                              */ -}}
{{- $opSshVaultWork := "Employee" -}}
{{- $opSshVaultPersonal := "Development" -}}
{{- $opSshVault := "" -}}
{{- if get . "opSshVault" -}}
{{-   $opSshVault = .opSshVault -}}
{{- end -}}

{{- /* Now that work/personal is known, fall back to the matching default key.  */ -}}
{{- /* A value that is merely one of the shipped defaults is not a real         */ -}}
{{- /* override — re-pick it, so a config written by an earlier init (or on a   */ -}}
{{- /* machine that has since changed work/personal status) does not pin the    */ -}}
{{- /* wrong key forever.                                                       */ -}}
{{- $gitSigningKeyTrimmed := $gitSigningKey | toString | trim -}}
{{- if or (not $gitSigningKeyTrimmed) (eq $gitSigningKeyTrimmed $gitSigningKeyPersonal) (eq $gitSigningKeyTrimmed $gitSigningKeyWork) -}}
{{-   if $isWork -}}
{{-     $gitSigningKey = $gitSigningKeyWork -}}
{{-   else -}}
{{-     $gitSigningKey = $gitSigningKeyPersonal -}}
{{-   end -}}
{{- end -}}

{{- /* Same treatment for the SSH agent's vault: a persisted shipped default is */ -}}
{{- /* re-picked, only a differently-named vault counts as an override.         */ -}}
{{- $opSshVaultTrimmed := $opSshVault | toString | trim -}}
{{- if or (not $opSshVaultTrimmed) (eq $opSshVaultTrimmed $opSshVaultPersonal) (eq $opSshVaultTrimmed $opSshVaultWork) -}}
{{-   if $isWork -}}
{{-     $opSshVault = $opSshVaultWork -}}
{{-   else -}}
{{-     $opSshVault = $opSshVaultPersonal -}}
{{-   end -}}
{{- end -}}

################################################################################
# Chezmoi configuration file
################################################################################

scriptTempDir: "~/tmp"

git:
  autoCommit: true
  autoPush: true
  # Conventional Commits message, so the commit-msg hook accepts autoCommits.
  commitMessageTemplateFile: .commit_message.tmpl
diff:
  # pager: delta
{{- if lookPath "ksdiff" }}
  command: "ksdiff"
  args:
    - "--partial-changeset"
    - "--relative-path"
    - "{{ `{{ .Target }}` }}"
    - "--"
    - "{{ `{{ .Target }}` }}"
    - "{{ `{{ .Destination }}` }}"
{{- end }}
{{- if lookPath "bcomp" }}
merge:
  command: "bcomp"
  args:
    - "{{ `{{ .Destination }}` }}"
    - "{{ `{{ .Source }}` }}"
    - "{{ `{{ .Target }}` }}"
    - "{{ `{{ .Source }}` }}"
{{- end }}
textconv:
- pattern: "**/*.plist"
  command: "plutil"
  args:
  - "-convert"
  - "xml1"
  - "-o"
  - "-"
  - "-"
data:
    appearance: {{ $appearance | quote }}
    codespaces: {{ $codespaces }}
    email: {{ $email | quote }}
    entraIDTenantId: {{ $entraIDTenantId | quote }}
    entraIDTenantName: {{ $entraIDTenantName | quote }}
    ephemeral: {{ $ephemeral }}
    gitSigningKey: {{ $gitSigningKey | quote }}
    githubUsername: {{ $githubUsername | quote }}
    hostname: {{ $hostname | quote }}
    isADDomainJoined: {{ $isADDomainJoined }}
    isEntraIDJoined: {{ $isEntraIDJoined }}
    isEntraRegistered: {{ $isEntraRegistered }}
    isIntuneJoined: {{ $isIntuneJoined }}
    isWork: {{ $isWork }}
    name: {{ $name | quote }}
    opCopilotEnvironmentId: {{ $opCopilotEnvironmentId | quote }}
    osid: {{ $osID | quote }}
    opShellPlugins: {{ $opShellPluginList | toJson }}
    opSshSignProgram: {{ $opSshSignProgram | quote }}
    opSshVault: {{ $opSshVault | quote }}
    roles: {{ $roles | toJson }}
    uname_arch: {{ $uname_arch }}
    role:
{{- range $r := $roleNames }}
      {{ $r }}: {{ index $role $r }}
{{- end }}
    wsl: {{ $wsl }}
