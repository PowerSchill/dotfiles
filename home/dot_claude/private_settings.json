{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "savvy-progress@claude-kit": true,
    "skins@hellosverre-mods": true,
    "reflect-mod@claude-reflect-marketplace": true,
    "cache-tax@claude-code-mods": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "shortcuts-playground": {
      "source": {
        "source": "git",
        "url": "https://github.com/viticci/shortcuts-playground-plugin.git"
      }
    },
    "pretty-claude": {
      "source": {
        "source": "directory",
        "path": "/Users/powerschill/Projects/pretty_claude"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    },
    "claude-reflect-marketplace": {
      "source": {
        "source": "github",
        "repo": "bayramannakov/claude-reflect"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-mods"
      }
    }
  },
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "savvy-progress@claude-kit": {
      "options": {
        "language": "auto"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
