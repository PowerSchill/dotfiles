{{- /*
  The Brewfile for this Machine, from .packages.homebrew in
  .chezmoidata/packages.yaml. Takes the chezmoi template context.

  `base` is always included; each enabled Role adds its own bucket. Platforms are
  filtered here, not with `OS.linux?` in the Brewfile, because Ruby cannot tell
  WSL from other Linux. Homebrew itself skips casks and `mas` where they do not
  apply, so only macOS-only formulae need `platforms:`.
*/ -}}
{{- $brew := .packages.homebrew -}}
{{- $buckets := prepend .roles "base" -}}
{{- $ephemeral := or .ephemeral (eq (env "EPHEMERAL") "true") -}}
{{- $platform := "linux" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $platform = "macos" -}}
{{- else if .wsl -}}
{{-   $platform = "wsl" -}}
{{- end -}}
{{- /* Key in packages.yaml, Brewfile keyword, default platforms, heading. */ -}}
{{- $sections := list
      (list "taps" "tap" (list) "Taps")
      (list "brews" "brew" (list) "Formulae")
      (list "casks" "cask" (list) "Casks")
      (list "mas" "mas" (list) "Mac App Store apps")
      (list "winget" "winget" (list "wsl") "WinGet packages")
      (list "vscode" "vscode" (list) "VS Code extensions")
      (list "go" "go" (list) "Go packages")
      (list "cargo" "cargo" (list) "Cargo crates")
      (list "uv" "uv" (list) "uv tools")
      (list "npm" "npm" (list) "npm packages")
      (list "krew" "krew" (list) "Krew plugins")
      (list "flatpak" "flatpak" (list "linux") "Flatpak apps") -}}
####################################################################################################
# Generated by chezmoi from .chezmoidata/packages.yaml
# Buckets: {{ $buckets | join ", " }}
####################################################################################################
{{- range $name, $value := index $brew "env" }}
ENV[{{ $name | quote }}] = {{ template "brewRuby.tmpl" (toString $value) }}
{{- end }}
{{- with index $brew "caskArgs" }}
cask_args
{{- $first := true -}}
{{- range $key, $value := . -}}
{{- if not $first }},{{ end }}{{ $first = false }} {{ $key }}: {{ template "brewRuby.tmpl" $value -}}
{{- end -}}
{{- end -}}
{{- range $section := $sections -}}
{{-   $key := index $section 0 -}}
{{-   $lists := index $brew $key | default dict -}}
{{-   $used := false -}}
{{-   range $bucket := $buckets -}}
{{-     if index $lists $bucket -}}{{- $used = true -}}{{- end -}}
{{-   end -}}
{{-   if $used }}

####################################################################################################
# {{ index $section 3 }}
####################################################################################################
{{-     range $bucket := $buckets -}}
{{-       template "brewEntries.tmpl" (dict "items" (index $lists $bucket) "type" (index $section 1) "platform" $platform "defaults" (index $section 2) "ephemeral" $ephemeral) -}}
{{-     end -}}
{{-   end -}}
{{- end }}
