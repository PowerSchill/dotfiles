{{- if and (ne .chezmoi.os "windows") (not .ephemeral) -}}
#!/usr/bin/env bash
# Install the git hooks into the chezmoi source repo. Every hook runs a
# `mise run check:*` task (docs/adr/0001), so this needs mise.
# Re-runs whenever the hook config changes.
# .pre-commit-config.yaml hash: {{ joinPath .chezmoi.workingTree ".pre-commit-config.yaml" | include | sha256sum }}
set -euo pipefail

mise=""
for m in "$(command -v mise 2>/dev/null || true)" "$HOME/.local/bin/mise"; do
  if [[ -n "$m" && -x "$m" ]]; then
    mise="$m"
    break
  fi
done

if [[ -z "$mise" ]]; then
  echo "git hooks: mise not found, skipping. Run tools/bootstrap.sh in {{ .chezmoi.workingTree }}" >&2
  exit 0
fi

cd {{ .chezmoi.workingTree | quote }}
MISE_TRUSTED_CONFIG_PATHS={{ .chezmoi.workingTree | quote }} "$mise" run hooks:install
{{ end -}}
