#!/bin/bash

# A failure must fail the script: chezmoi only re-runs run_onchange scripts that failed.
set -euo pipefail

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
LOG_TAG="packages"

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

{{- /* `base` is always installed; each enabled role appends its own bucket. */ -}}
{{ $buckets := prepend .roles "base" }}

{{- /* Packages in vmExclude are skipped inside VMs (systemd-detect-virt prints "none" on bare metal). */ -}}
{{ $virt := output "sh" "-c" "systemd-detect-virt 2>/dev/null || true" | trim }}
{{ $skip := list }}
{{ if and $virt (ne $virt "none") -}}
{{   $skip = .packages.linux.vmExclude | default list }}
{{ end -}}

log_state "Installing packages: {{ .osid }}"

{{ if or (eq .osid "linux-debian") (eq .osid "linux-ubuntu") (eq .osid "linux-raspbian") -}}

########################################
# Custom pre-install functions
########################################

# Wezterm apt repo configuration
curl -fsSL https://apt.fury.io/wez/gpg.key | {{ $sudo }}gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | {{ $sudo }}tee /etc/apt/sources.list.d/wezterm.list
{{ $sudo }}chmod 644 /usr/share/keyrings/wezterm-fury.gpg

########################################
# Installing native os packages
########################################
{{ $sudo }}apt-get update
# Releases differ (Ubuntu 24.04 has no fastfetch or lazygit), and one unknown name
# makes apt-get install nothing at all. Skip what this release does not carry.
apt_packages=()
for package in
{{- range $b := $buckets }}
{{- range (index $.packages.linux.debian.packages $b) }}{{ if not (has . $skip) }} {{ . | quote }}{{ end }}
{{- end }}
{{- end }}; do
  # `apt-cache show` also succeeds for a name with no installable version.
  if [[ "$(apt-cache policy "$package" 2>/dev/null)" == *"Candidate: "[!\(]* ]]; then
    apt_packages+=("$package")
  else
    log_warn "Package not available on this release, skipping: $package"
  fi
done
{{ $sudo }}apt-get install -y "${apt_packages[@]}"

########################################
# Installing cargo packages
########################################
{{ $sudo }}apt -y install cargo
{{- range $b := $buckets }}
{{- range (index $.packages.linux.debian.cargo $b) }}
cargo install  {{ . | quote }}
{{- end }}
{{- end }}

########################################
# Installing snap packages
########################################
# Containers and plain Debian have no working snapd (the snap command alone can be
# installed as a dependency); that is expected, not a failure.
if command -v snap >/dev/null 2>&1 && [ -S /run/snapd.socket ]; then
  :
{{- range $b := $buckets }}
{{- range (index $.packages.linux.debian.snap $b) }}
{{- if not (has . $skip) }}
  {{ $sudo }}snap install {{ . | quote }} --classic
{{- end }}
{{- end }}
{{- end }}
else
  log_warn "snapd not available, skipping snap packages"
fi

{{ end -}}

{{ if (eq .osid  "linux-fedora"  ) -}}
########################################
# Enabling copr repos (before dnf install, which pulls packages from them)
########################################
{{- range $b := $buckets }}
{{- range (index $.packages.linux.fedora.copr $b) }}
{{ $sudo }}dnf -y copr enable  {{ . | quote }}
{{- end }}
{{- end }}

########################################
# Installing native os packages
########################################
# Without this, one name Fedora does not carry makes dnf install nothing at all.
{{ $sudo }}dnf -y install --skip-unavailable
{{- range $b := $buckets }}
{{- range (index $.packages.linux.fedora.packages $b) }}{{ if not (has . $skip) }} {{ . | quote }}{{ end }}
{{- end }}
{{- end }}

########################################
# Installing cargo packages
########################################
{{ $sudo }}dnf -y install cargo
{{- range $b := $buckets }}
{{- range (index $.packages.linux.fedora.cargo $b) }}
cargo install  {{ . | quote }}
{{- end }}
{{- end }}

{{ end -}}

log_result "Packages installed: {{ .osid }}"
