#!/bin/bash

# A failure must fail the script: chezmoi only re-runs run_onchange scripts that failed.
set -euo pipefail

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
LOG_TAG="packages"

{{- /*
  Native packages only: what Homebrew needs first and what it cannot provide
  (docs/adr/0004). Everything else comes from the Brewfile, which a later script
  installs: packages/ sorts after linux/.
*/ -}}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

{{- /* `base` is always installed; each enabled role appends its own bucket. */ -}}
{{ $buckets := prepend .roles "base" }}

{{- /* Packages in vmExclude are skipped inside VMs (systemd-detect-virt prints "none" on bare metal). */ -}}
{{ $virt := output "sh" "-c" "systemd-detect-virt 2>/dev/null || true" | trim }}
{{ $skip := list }}
{{ if and $virt (ne $virt "none") -}}
{{   $skip = .packages.linux.vmExclude | default list }}
{{ end -}}

{{- /* Which native list applies. A derivative counts as the distro it says it is like. */ -}}
{{ $id := .osid | trimPrefix "linux-" }}
{{ $like := "" }}
{{ if hasKey .chezmoi.osRelease "idLike" }}{{ $like = .chezmoi.osRelease.idLike }}{{ end }}
{{ $family := "" }}
{{ if or (has $id (list "debian" "ubuntu" "raspbian")) (contains "debian" $like) (contains "ubuntu" $like) -}}
{{   $family = "debian" -}}
{{ else if eq $id "fedora" -}}
{{   $family = "fedora" -}}
{{ else if or (has $id (list "rhel" "centos" "rocky" "almalinux")) (contains "rhel" $like) (contains "centos" $like) -}}
{{   $family = "rhel" -}}
{{ else if or (eq $id "arch") (contains "arch" $like) -}}
{{   $family = "arch" -}}
{{ end -}}

log_state "Installing native packages: {{ .osid }}"

{{ if eq $family "debian" -}}
{{ if .role.gui -}}
########################################
# Custom pre-install functions
########################################

# Wezterm apt repo configuration, for wezterm-nightly in the gui bucket
{{ $sudo }}apt-get update
{{ $sudo }}apt-get install -y gnupg
curl -fsSL https://apt.fury.io/wez/gpg.key | {{ $sudo }}gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | {{ $sudo }}tee /etc/apt/sources.list.d/wezterm.list
{{ $sudo }}chmod 644 /usr/share/keyrings/wezterm-fury.gpg

{{ end -}}
########################################
# Installing native os packages
########################################
{{ $sudo }}apt-get update
# Releases differ, and one unknown name makes apt-get install nothing at all.
# Skip what this release does not carry.
apt_packages=()
for package in
{{- range $b := $buckets }}
{{- range (index $.packages.linux.debian.packages $b) }}{{ if not (has . $skip) }} {{ . | quote }}{{ end }}
{{- end }}
{{- end }}; do
  # `apt-cache show` also succeeds for a name with no installable version.
  if [[ "$(apt-cache policy "$package" 2>/dev/null)" == *"Candidate: "[!\(]* ]]; then
    apt_packages+=("$package")
  else
    log_warn "Package not available on this release, skipping: $package"
  fi
done
{{ $sudo }}apt-get install -y "${apt_packages[@]}"

########################################
# Installing snap packages
########################################
# Containers and plain Debian have no working snapd (the snap command alone can be
# installed as a dependency); that is expected, not a failure.
if command -v snap >/dev/null 2>&1 && [ -S /run/snapd.socket ]; then
  :
{{- range $b := $buckets }}
{{- range (index $.packages.linux.debian.snap $b) }}
{{- if not (has . $skip) }}
  {{ $sudo }}snap install {{ . | quote }} --classic
{{- end }}
{{- end }}
{{- end }}
else
  log_warn "snapd not available, skipping snap packages"
fi

{{ else if or (eq $family "fedora") (eq $family "rhel") -}}
{{ $lists := index .packages.linux $family -}}
########################################
# Enabling copr repos (before dnf install, which pulls packages from them)
########################################
{{- range $b := $buckets }}
{{- range (index (index $lists "copr" | default dict) $b) }}
{{ $sudo }}dnf -y copr enable {{ . | quote }}
{{- end }}
{{- end }}

########################################
# Installing native os packages
########################################
{{- range $b := $buckets }}
{{- range (index (index $lists "groups" | default dict) $b) }}
{{ $sudo }}dnf -y group install {{ . | quote }}
{{- end }}
{{- end }}
# Without this, one name the distro does not carry makes dnf install nothing at all.
{{ $sudo }}dnf -y install --skip-unavailable
{{- range $b := $buckets }}
{{- range (index $lists.packages $b) }}{{ if not (has . $skip) }} {{ . | quote }}{{ end }}
{{- end }}
{{- end }}

{{ else if eq $family "arch" -}}
########################################
# Installing native os packages
########################################
{{ $sudo }}pacman -S --needed --noconfirm
{{- range $b := $buckets }}
{{- range (index $.packages.linux.arch.packages $b) }}{{ if not (has . $skip) }} {{ . | quote }}{{ end }}
{{- end }}
{{- end }}

{{ else -}}
log_warn "No native package list for {{ .osid }}. Homebrew needs a C compiler, procps, curl, file and git: https://docs.brew.sh/Homebrew-on-Linux"

{{ end -}}
log_result "Native packages installed: {{ .osid }}"
