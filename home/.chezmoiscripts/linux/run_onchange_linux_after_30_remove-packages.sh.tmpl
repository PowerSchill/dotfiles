{{ if eq .osid "linux-ubuntu" -}}

{{ $packages := list
     "aisleriot"
     "gnome-mahjongg"
     "gnome-mines"
     "gnome-sudoku"
     "thunderbird" -}}
{{ $snaps := list "firefox" -}}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

#!/bin/bash

set -eufo pipefail

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
LOG_TAG="remove-packages"

log_state "Removing unwanted packages"

{{ $sudo }}apt-get remove -y {{ $packages | join " " }}

{{ if lookPath "snap" }}
{{   range $snaps }}
snap info {{ . }} && {{ $sudo }}snap remove {{ . }}
{{   end }}
{{ end }}

log_result "Unwanted packages removed"

{{ end -}}
