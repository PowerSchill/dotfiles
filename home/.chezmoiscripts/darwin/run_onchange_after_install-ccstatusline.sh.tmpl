#!/usr/bin/env bash
# Install ccstatusline globally so the Claude Code statusLine can invoke the
# binary directly instead of paying an npx/bunx registry round-trip per render. The settings call ~/.bun/bin/ccstatusline, which runs on node. Bump the
# version by hand; changing it re-runs this script.
set -euo pipefail

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
LOG_TAG="ccstatusline"

{{- if not .ephemeral }}

if ! command -v bun >/dev/null 2>&1; then
    log_warn "bun not found, skipping ccstatusline install"
    exit 0
fi

log_state "Installing ccstatusline"
# Pin the location: bun otherwise installs under $XDG_CACHE_HOME/.bun when that
# is set, and the settings call ~/.bun/bin/ccstatusline.
BUN_INSTALL="$HOME/.bun" bun install -g ccstatusline@2.2.33
log_result "ccstatusline installed"

{{- end }}
