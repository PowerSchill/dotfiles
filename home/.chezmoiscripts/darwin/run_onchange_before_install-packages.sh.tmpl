{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
LOG_TAG="packages"

{{ $isEphemeral := or .ephemeral (eq (env "EPHEMERAL") "true") }}
{{- /* `base` is always installed; each enabled role appends its own bucket. */ -}}
{{ $buckets := prepend .roles "base" }}

cat >~/.Brewfile <<EOF

####################################################################################################
# Generated by chezmoi from .chezmoidata/packages.yaml
# Buckets: {{ $buckets | join ", " }}
####################################################################################################

####################################################################################################
# HomeBrew Taps
####################################################################################################
{{- range $b := $buckets }}
{{- template "brewList.tmpl" (list (index $.packages.darwin.taps $b) "tap" $isEphemeral) }}
{{- end }}

####################################################################################################
# HomeBrew Formulae
####################################################################################################
{{- range $b := $buckets }}
{{- template "brewList.tmpl" (list (index $.packages.darwin.brews $b) "brew" $isEphemeral) }}
{{- end }}

####################################################################################################
# HomeBrew Casks
####################################################################################################
{{- range $b := $buckets }}
{{- template "brewList.tmpl" (list (index $.packages.darwin.casks $b) "cask" $isEphemeral) }}
{{- end }}

EOF

log_state "Running brew bundle"
brew bundle --file=~/.Brewfile
log_result "brew bundle complete"
{{ end -}}
