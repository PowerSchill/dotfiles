{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash

# run_onchange hash input: re-run when ~/.Brewfile.local changes. The packages are already in this
# script's rendered body.
# Brewfile.local sha256: {{ $local := joinPath .chezmoi.homeDir ".Brewfile.local" }}{{ if stat $local }}{{ include $local | sha256sum }}{{ else }}absent{{ end }}

# A failure must fail the script: chezmoi only re-runs run_onchange scripts that failed.
set -euo pipefail

# shellcheck source=home/dot_config/shell/functions/log.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/log.sh"
# shellcheck source=home/dot_config/shell/functions/homebrew.sh
. "{{ .chezmoi.sourceDir }}/dot_config/shell/functions/homebrew.sh"
LOG_TAG="packages"

# Quoted: values like ${HOMEBREW_PREFIX} in a postinstall are for Homebrew, not this shell.
cat >~/.Brewfile <<'BREWFILE'
{{ template "brewfile.tmpl" . }}
BREWFILE

# ~/.Brewfile.local is yours and unmanaged. The Brewfile is Ruby, so it reads the local file when
# brew runs: edits count at once, and `bundle cleanup` will not uninstall what the file lists.
cat >>~/.Brewfile <<'LOCAL'

####################################################################################################
# Local entries for this Machine, from ~/.Brewfile.local (not managed by chezmoi)
####################################################################################################
local_brewfile = File.expand_path("~/.Brewfile.local")
instance_eval(File.read(local_brewfile), local_brewfile) if File.exist?(local_brewfile)
LOCAL

# A Machine Homebrew cannot serve warns and carries on; it must not fail Apply.
if ! homebrew_prepare; then
  exit 0
fi

# Every Machine upgrades from current metadata, whatever the calling shell set.
log_state "Updating Homebrew"
brew update

log_state "Running brew bundle"
brew bundle --file=~/.Brewfile
log_result "brew bundle complete"
{{ end -}}
