#!/bin/bash
# Main bashrc - source this from ~/.bashrc or ~/.bash_profile
#
# Add this line to your ~/.bashrc:
# [ -f ~/.config/shell/config.bash ] && source ~/.config/shell/config.bash

# If not running interactively, don't do anything
# This prevents errors from Docker Desktop WSL integration messages
case $- in
*i*) ;;
*) return ;;
esac

# Homebrew on PATH, and where `brew bundle --global` finds the Brewfile
if [ -f "$HOME/.config/shell/homebrew-env.sh" ]; then
  # shellcheck source=home/dot_config/shell/homebrew-env.sh
  source "$HOME/.config/shell/homebrew-env.sh"
fi

# Source the main shell config
if [ -f "$HOME/.config/shell/config.bash" ]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/shell/config.bash"
fi

# Bash completion
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    # shellcheck source=/dev/null
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    # shellcheck source=/dev/null
    . /etc/bash_completion
  fi
fi
