################################################################################
# SSH Cconfig
################################################################################

# Allow for customized independent configurations.
Include ~/.ssh/config.d/*.conf

Host *
{{- if .role.onepassword }}
{{- if eq .chezmoi.os "linux" }}
	IdentityAgent ~/.1password/agent.sock
{{- else if eq .chezmoi.os "darwin" }}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
{{- else }}
	# No onepassword role: fall back to the system ssh-agent via $SSH_AUTH_SOCK.
{{- end }}
	ServerAliveInterval 60
	ServerAliveCountMax 3
	TCPKeepAlive yes
	ConnectTimeout 30
	ControlMaster auto
	ControlPath ~/.ssh/control-%h-%p-%r
	ControlPersist yes
	# A forwarded agent can be used by anyone with root on the remote host. To opt a
	# host in, add `ForwardAgent yes` for it in ~/.ssh/config.d/ (first value wins).
	ForwardAgent no
	GSSAPIAuthentication no
	GSSAPIDelegateCredentials no

