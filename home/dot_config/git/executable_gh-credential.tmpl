#!/bin/sh
# git credential helper for github.com: `gh auth git-credential`, routed through
# the 1Password shell plugin when gh is wrapped by one. git runs helpers directly,
# bypassing the gh() shell function, so without this git would use gh's own
# keyring account (hosts.yml) instead of the one picked in `op plugin init gh`.
# Over SSH `op plugin run` cannot unlock, so use plain gh there (as op-plugins.sh).
# Coding-agent sessions also use plain gh: 1Password authorizes the CLI per
# terminal session and each agent command is a new one, so the plugin would
# re-prompt after every 10 minutes of inactivity. CLAUDECODE marks Claude Code;
# T3 Code sets T3CODE_PROJECT_ROOT in its terminals and agents, and
# T3CODE_CLI_PATH in the app, which runs git itself.
{{- $gh := lookPath "gh" | replace "\\" "/" }}
{{- if and .role.onepassword (not .wsl) (has "gh" .opShellPlugins) }}
if [ -z "${SSH_CONNECTION:-}" ] && [ -z "${CLAUDECODE:-}" ] \
  && [ -z "${T3CODE_PROJECT_ROOT:-}" ] && [ -z "${T3CODE_CLI_PATH:-}" ] \
  && command -v op >/dev/null 2>&1; then
  exec op plugin run -- gh auth git-credential "$@"
fi
{{- end }}
exec '{{ $gh }}' auth git-credential "$@"
