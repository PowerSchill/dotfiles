# Ghostty configuration
#
# Ported from ~/.config/wezterm. Keep the two in sync when either changes.
# Reference: `ghostty +show-config --default --docs`, `ghostty +list-actions`

# -----------------------------------------------------------------------------
# Fonts
# -----------------------------------------------------------------------------
font-family = MesloLGS NF
font-family-bold = MesloLGS NF Bold
font-family-italic = MesloLGS NF Italic
font-family-bold-italic = MesloLGS NF Bold Italic

font-size = 12

font-thicken = true

font-feature = calt
font-feature = liga

# WezTerm's line_height = 1.2
adjust-cell-height = 20%

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------
# Follows the macOS system appearance automatically.
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-theme = auto

background-opacity = 0.95
background-blur = 30

scrollbar = never
copy-on-select = false

# WezTerm uses a blurred background image in dark mode only. Ghostty has no
# per-appearance image, so it is off by default; uncomment to apply everywhere.
background-image = ~/.config/wezterm/assets/Wezterm Background Blurred.png
background-image-opacity = 0.35
background-image-fit = cover

# WezTerm window_padding = 3 on all sides
window-padding-x = 3
window-padding-y = 3
window-padding-balance = true

# Tabs live in the titlebar (closest match to WezTerm's window_decorations =
# "RESIZE" with the retro tab bar always visible).
macos-titlebar-style = tabs
macos-window-shadow = true

# Dim inactive splits slightly, like WezTerm's inactive_pane_hsb
unfocused-split-opacity = 0.85

mouse-hide-while-typing = true

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------
shell-integration = detect
shell-integration-features = cursor,sudo,title

# WezTerm: audible_bell = "Disabled"
bell-features = no-audio,no-system,attention,title

# WezTerm: window_close_confirmation = "AlwaysPrompt"
confirm-close-surface = true
quit-after-last-window-closed = false

copy-on-select = clipboard
window-inherit-working-directory = true
window-inherit-font-size = true
window-save-state = never

link-url = true

auto-update = check

# -----------------------------------------------------------------------------
# Keybindings — direct (⌘-based)
# -----------------------------------------------------------------------------
# super+shift+p = toggle_command_palette is already a Ghostty default.
keybind = super+shift+r=prompt_tab_title
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+o=toggle_background_opacity

# -----------------------------------------------------------------------------
# Keybindings — leader sequences (WezTerm leader = CTRL+q)
# -----------------------------------------------------------------------------
keybind = ctrl+q>c=new_tab
keybind = ctrl+q>x=close_surface
keybind = ctrl+q>b=previous_tab
keybind = ctrl+q>n=next_tab

# Splits
keybind = ctrl+q>backslash=new_split:right
keybind = ctrl+q>minus=new_split:down
keybind = ctrl+q>z=toggle_split_zoom
keybind = ctrl+q>e=equalize_splits

# Move between splits (vim keys)
keybind = ctrl+q>h=goto_split:left
keybind = ctrl+q>j=goto_split:down
keybind = ctrl+q>k=goto_split:up
keybind = ctrl+q>l=goto_split:right

# Resize splits
keybind = ctrl+q>left=resize_split:left,5
keybind = ctrl+q>down=resize_split:down,5
keybind = ctrl+q>up=resize_split:up,5
keybind = ctrl+q>right=resize_split:right,5

# Jump to tab by number
keybind = ctrl+q>1=goto_tab:1
keybind = ctrl+q>2=goto_tab:2
keybind = ctrl+q>3=goto_tab:3
keybind = ctrl+q>4=goto_tab:4
keybind = ctrl+q>5=goto_tab:5
keybind = ctrl+q>6=goto_tab:6
keybind = ctrl+q>7=goto_tab:7
keybind = ctrl+q>8=goto_tab:8
keybind = ctrl+q>9=goto_tab:9
keybind = ctrl+q>0=last_tab

# Rename the current tab
keybind = ctrl+q>comma=prompt_tab_title


### Quick terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.1
